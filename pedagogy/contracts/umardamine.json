  "purpose_ru": "Ученик самостоятельно округляет ранее не встречавшиеся натуральные числа до указанного разряда от десятков до миллиардов, включая серединные и переходные случаи.",
  "entry_requirements": [
    "Разрядный состав десятичной записи натуральных чисел",
    "Сравнение соседних кратных 10, 100, 1000"
  ],
  "learning_evidence_ru": "Обобщённый навык подтверждается ответами без подсказки на новых числах и в разных целевых разрядах, а не только количеством повторов.",
  "mastery_policy": {
    "kind": "draft_subject_to_testing",
    "initial_diagnostic": true,
    "unseen_transfer": true,
    "delayed_retention_check": true,
    "note_ru": "Порог и длина контрольных сессий утверждать по результатам тестов. Не объявлять освоение после одной правильной задачи."
  },
